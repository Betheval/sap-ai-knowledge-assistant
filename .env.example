# Copy to .env and adjust. CAP loads .env automatically in the development profile.
# Never commit .env.

# Ollama host on the local network (see docs/adr/0004-ollama-on-remote-host.md)
OLLAMA_BASE_URL=http://192.168.1.50:11434

# Optional overrides of the defaults in package.json (cds.requires.llm)
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT_MS=120000

# PostgreSQL knowledge base, used by the `pg` profile (see docs/adr/0011-persistence-sqlite-then-postgres.md).
# Database and user are set in package.json; create them with infra/postgres/setup.sql.
CDS_REQUIRES_DB_CREDENTIALS_HOST=192.168.1.50
CDS_REQUIRES_DB_CREDENTIALS_PORT=5432
CDS_REQUIRES_DB_CREDENTIALS_PASSWORD=change-me
