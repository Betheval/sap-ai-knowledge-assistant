{
  "name": "sap-ai-knowledge-assistant",
  "version": "0.1.0",
  "description": "RAG assistant that answers SAP CAP development questions from the Capire documentation, with cited sources.",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typer": "cds-typer \"*\" --outputDirectory @cds-models",
    "postinstall": "npm run typer",
    "watch": "npm run typer && cds-tsx watch --profile development,pg",
    "watch:fake": "npm run typer && cds-tsx watch --profile development,fake-ai",
    "db:deploy": "cds deploy --profile development,pg && tsx scripts/apply-retrieval-schema.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "test": "npm run typer && jest",
    "typecheck": "npm run typer && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "dependencies": {
    "@cap-js/postgres": "^3.1.2",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds": "^10.1.1"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@eslint/js": "^10",
    "@sap/cds-dk": "^10.1.0",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "cds": {
    "requires": {
      "kinds": {
        "ollama-llm": {
          "impl": "srv/lib/adapters/ollama/ollama-llm-service"
        },
        "fake-llm": {
          "impl": "srv/lib/adapters/fake/fake-llm-service"
        },
        "fake-retriever": {
          "impl": "srv/lib/adapters/fake/fake-retriever-service"
        },
        "ollama-embeddings": {
          "impl": "srv/lib/adapters/ollama/ollama-embedding-service"
        },
        "hybrid-pg-retriever": {
          "impl": "srv/lib/adapters/postgres/hybrid-retriever-service"
        }
      },
      "llm": {
        "kind": "ollama-llm",
        "chatModel": "qwen2.5:7b",
        "numCtx": 16384,
        "maxOutputTokens": 1024,
        "temperature": 0.2,
        "timeoutMs": 120000
      },
      "embeddings": {
        "kind": "ollama-embeddings",
        "embeddingModel": "bge-m3",
        "dimensions": 1024,
        "numCtx": 8192,
        "timeoutMs": 120000
      },
      "retriever": {
        "kind": "fake-retriever",
        "minScore": 0.2
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "KnowledgeUser"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "KnowledgeUser"
              ]
            }
          }
        }
      },
      "[pg]": {
        "db": {
          "kind": "postgres",
          "credentials": {
            "database": "knowledge",
            "user": "knowledge_app"
          }
        },
        "retriever": {
          "kind": "hybrid-pg-retriever",
          "candidates": 30,
          "rrfK": 60,
          "minSimilarity": 0.5,
          "stopwords": [
            "cap"
          ]
        }
      },
      "[fake-ai]": {
        "llm": {
          "kind": "fake-llm"
        }
      },
      "[test]": {
        "llm": {
          "kind": "fake-llm"
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "KnowledgeUser"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "KnowledgeUser"
              ]
            }
          }
        }
      }
    },
    "rag": {
      "topK": 6,
      "historyMessages": 6
    },
    "ingestion": {
      "capire": {
        "repo": "cap-js/docs",
        "commit": "233700907188d1408a284a60114d93e7ae656e9a",
        "folders": [
          "get-started",
          "guides",
          "cds",
          "node.js",
          "java",
          "tools",
          "plugins"
        ],
        "baseUrl": "https://cap.cloud.sap/docs"
      },
      "maxChunkTokens": 800,
      "maxDatabaseBytes": 5368709120,
      "batchSize": 16
    }
  }
}
